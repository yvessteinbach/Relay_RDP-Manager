{
  "name": "relay-rdp-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first, cross-platform Remote Desktop connection manager.",
  "workspaces": [
    "docs"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "docs:dev": "npm run start --workspace docs",
    "docs:build": "npm run build --workspace docs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "check": "npm run lint && npm run format:check && npm run test && npm run build && npm run docs:build"
  },
  "dependencies": {
    "@carbon/icons-react": "11.88.0",
    "@carbon/react": "1.116.0",
    "@carbon/styles": "1.115.0",
    "@tauri-apps/api": "2.11.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.6",
    "globals": "16.4.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "sass": "1.104.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
